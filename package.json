{
  "name": "planckbits",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:clean": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\" && vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "og": "node scripts/make-og.mjs",
    "social": "node scripts/make-social.mjs",
    "standalone": "node scripts/build-standalone.mjs",
    "serve": "npm run build && npm start"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.3",
    "sharp": "^0.35.3",
    "typescript": "~6",
    "vite": "^8",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4"
  }
}
