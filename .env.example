# ---------------------------------------------------------------------------
# Client (VITE_ prefixed vars are PUBLIC — they ship inside the browser bundle)
#
# These are read at BUILD time, not at run time. Changing one on Railway means
# a rebuild, not a restart.
# ---------------------------------------------------------------------------

# Supabase. The anon key is public by design; row-level security is what
# protects the data, not the key. Setting both switches the roster from the
# local fixture to Postgres — see src/lib/roster-source.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# $PLANCK contract address. Public — it is printed on the site on purpose.
# Until this is set, the contract section says "not live yet".
VITE_PLANCK_CA=

# ---------------------------------------------------------------------------
# Server only. NEVER give any of these a VITE_ prefix — that would publish the
# secret in the browser bundle where anyone can read it.
# ---------------------------------------------------------------------------

# Birdeye API key. Used for holder counts and wallet holdings.
# Missing -> /api/token, /api/holding, /api/mint and /api/hire return 503.
BIRDEYE_API_KEY=

# $PLANCK mint address, once the tokens.xyz launch has happened.
# Missing -> the same four routes return 503 with "token_not_launched", which
# the frontend renders as "not live yet" rather than as an error.
PLANCK_MINT=

# Supabase service role key. Bypasses RLS; the only way rows are written.
# Missing -> /api/mint and /api/hire return 503; reads still work.
SUPABASE_SERVICE_ROLE_KEY=

# The server reads VITE_SUPABASE_URL if this is unset, so on Railway you only
# need one of the two.
SUPABASE_URL=

# Set by Railway automatically. Defaults to 3000 locally.
PORT=

# ---------------------------------------------------------------------------
# Not yet read by any code.
#
# Listed so the intent is on record, but setting them today does nothing.
# Do not treat them as part of the launch checklist.
# ---------------------------------------------------------------------------

# Phase 2: reading vault holdings from chain rather than from the fixture in
# src/lib/vault.ts. The public RPC rate-limits and blocks browsers, so this
# will need to be Helius or similar.
# SOLANA_RPC=

# Phase 2: the treasury address whose holdings /holdings will report.
# VAULT_ADDRESS=
