# ---------------------------------------------------------------------------
# Client (VITE_ prefixed vars are PUBLIC — they ship inside the browser bundle)
#
# These are read at BUILD time, not at run time. Changing one on Railway means
# a rebuild, not a restart.
# ---------------------------------------------------------------------------

# Supabase. The anon key is public by design; row-level security is what
# protects the data, not the key. Setting both switches the roster from the
# local fixture to Postgres — see src/lib/roster-source.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The $PLANCK mint address is NORMALLY NOT SET HERE.
#
# It lives in Postgres, in public_config.planck_mint, so launching the token
# is one statement rather than a rebuild and a redeploy:
#
#   update public_config set value = '<ADDRESS>' where key = 'planck_mint';
#
# Every process picks it up within ~15 seconds, with no restart. That matters
# because this variable is read at BUILD time: as an env var, launching meant
# redeploying, with the wrong address on the site for the whole deploy.
#
# It survives as a fallback for local development and for any deploy with no
# database. The database wins whenever it has a value — including when it
# holds NULL, which means "not launched" and must not be overridden.
VITE_PLANCK_MINT=

# ---------------------------------------------------------------------------
# Server only. NEVER give any of these a VITE_ prefix — that would publish the
# secret in the browser bundle where anyone can read it.
# ---------------------------------------------------------------------------

# Birdeye API key. Used for holder counts and wallet holdings.
# Missing -> /api/token, /api/holding, /api/mint and /api/hire return 503.
BIRDEYE_API_KEY=


# xStocks (api.xstocks.fi). Generated in the xStocks platform under
# Settings -> API. Server-side: it must never gain a VITE_ prefix.
#
# NOT YET CALLED BY ANY ROUTE — see the note at the bottom of README.md.
# /api/health reports whether it arrived so you can confirm Railway has it.
XSTOCKS_API_KEY=

# tokens.xyz. Reserved. Note that tokens.xyz is an asset explorer and data
# aggregator, not a launchpad: it charges no fees and pays no creator
# revenue, so it cannot be the source of the vault funding the site claims.
XTOKENS_API_KEY=

# Supabase service role key. Bypasses RLS; the only way rows are written.
# Missing -> /api/mint and /api/hire return 503; reads still work.
SUPABASE_SERVICE_ROLE_KEY=

# The server reads VITE_SUPABASE_URL if this is unset, so on Railway you only
# need one of the two.
SUPABASE_URL=

# Set by Railway automatically. Defaults to 3000 locally.
PORT=

# ---------------------------------------------------------------------------
# Not yet read by any code.
#
# Listed so the intent is on record, but setting them today does nothing.
# Do not treat them as part of the launch checklist.
# ---------------------------------------------------------------------------

# Phase 2: reading vault holdings from chain rather than from the fixture in
# src/lib/vault.ts. The public RPC rate-limits and blocks browsers, so this
# will need to be Helius or similar.
# SOLANA_RPC=

# Phase 2: the treasury address whose holdings /holdings will report.
# VAULT_ADDRESS=
