# ---------------------------------------------------------------------------
# Client (VITE_ prefixed vars are PUBLIC — they ship inside the browser bundle)
# ---------------------------------------------------------------------------

# Supabase. The anon key is public by design; row-level security is what
# protects the data, not the key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server only. NEVER give any of these a VITE_ prefix — that would publish the
# secret in the browser bundle where anyone can read it.
# ---------------------------------------------------------------------------

# Birdeye API key. Used for holder counts and wallet holdings.
BIRDEYE_API_KEY=

# $PLANCK mint address, once the tokens.xyz launch has happened.
PLANCK_MINT=

# Supabase service role key. Bypasses RLS; the only way rows are written.
SUPABASE_SERVICE_ROLE_KEY=

# Solana RPC (Helius or similar). The public endpoint rate-limits and blocks
# browsers.
SOLANA_RPC=

# Treasury address whose holdings are shown on /holdings.
VAULT_ADDRESS=
