# Supabase. The anon key is public by design and ships in the client bundle;
# row-level security is what protects the data, not the key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never prefix a service-role key with VITE_ — that would publish it in the
# browser bundle. Server-side only.
# SUPABASE_SERVICE_ROLE_KEY=
